{
  "$schema": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/action.json",
  "name": "pin",
  "description": "Pins an Obsidian Note card to a token, for Show lore. Args: elementId, noteCardId, replyTo.",
  "hook": 0,
  "prefix": "obsidian",
  "genericPermission": 0,
  "gmPermission": 31,
  "content": [
    {
      "Type": "RequirePermission",
      "Data": {
        "Label": "Only GMs",
        "EntityId": "%gameId%",
        "Permission": "Edit",
        "StopIfDenied": true
      }
    },
    {
      "Type": "RunScript",
      "Data": {
        "Label": "Check both",
        "Include": "obsidian_obsidian.js",
        "Script": "const target = String(vars.noteCardId || vars.cardId || '');\nconst notePath = /^[0-9a-fA-F-]{36}$/.test(target) ? game.getProperty(target, 'obsidian_path', '') : '';\nif (!isNotePath(notePath)) return outcome(vars, { kind: 'pinned', ok: false, error: 'Import the note first.' });\nif (!/^[0-9a-fA-F-]{36}$/.test(String(vars.elementId))) return outcome(vars, { kind: 'pinned', ok: false, error: 'Right-click a token and choose Pin Obsidian note.' });\nreturn outcome(vars, { kind: 'pinned', ok: true, cardId: target, message: 'Pinned to the token.' }, { target: target });"
      }
    },
    {
      "Type": "If",
      "Data": {
        "Label": "Stop if that failed",
        "Condition": "'%failed%' = 'yes'",
        "Then": [
          {
            "Type": "If",
            "Data": {
              "Label": "Tell the GM",
              "Condition": "'%hasReply%' = 'yes'",
              "Then": [
                {
                  "Type": "RunClientCommand",
                  "Data": {
                    "Label": "Answer the window that asked",
                    "Panel": "%replyTo%",
                    "Command": "Reply",
                    "Player": "%playerId%",
                    "Data": "%reply%"
                  }
                }
              ],
              "Else": [
                {
                  "Type": "SendChat",
                  "Data": {
                    "Label": "Or whisper it",
                    "Template": "Text",
                    "Title": "Obsidian",
                    "Message": "%notice%",
                    "Player": "%playerId%"
                  }
                }
              ]
            }
          },
          {
            "Type": "Exit",
            "Data": {
              "Label": "Stop"
            }
          }
        ]
      }
    },
    {
      "Type": "SetProperty",
      "Data": {
        "Label": "Pin it",
        "ParentId": "%elementId%",
        "PropertyName": "obsidian_card",
        "PropertyValue": "%target%"
      }
    },
    {
      "Type": "If",
      "Data": {
        "Label": "Tell the GM",
        "Condition": "'%hasReply%' = 'yes'",
        "Then": [
          {
            "Type": "RunClientCommand",
            "Data": {
              "Label": "Answer the window that asked",
              "Panel": "%replyTo%",
              "Command": "Reply",
              "Player": "%playerId%",
              "Data": "%reply%"
            }
          }
        ],
        "Else": [
          {
            "Type": "SendChat",
            "Data": {
              "Label": "Or whisper it",
              "Template": "Text",
              "Title": "Obsidian",
              "Message": "%notice%",
              "Player": "%playerId%"
            }
          }
        ]
      }
    }
  ]
}
