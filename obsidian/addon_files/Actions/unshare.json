{
  "$schema": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/action.json",
  "name": "unshare",
  "description": "Takes an Obsidian Note card back from the players. Args (from the viewer): noteCardId, replyTo.",
  "hook": 0,
  "prefix": "obsidian",
  "genericPermission": 0,
  "gmPermission": 31,
  "content": [
    {
      "Type": "RequirePermission",
      "Data": {
        "Label": "Only GMs",
        "EntityId": "%gameId%",
        "Permission": "Edit",
        "StopIfDenied": true
      }
    },
    {
      "Type": "RunScript",
      "Data": {
        "Label": "Which note",
        "Include": "obsidian_obsidian.js",
        "Script": "const target = String(vars.noteCardId || vars.cardId || '');\nconst notePath = /^[0-9a-fA-F-]{36}$/.test(target) ? game.getProperty(target, 'obsidian_path', '') : '';\nif (!isNotePath(notePath)) return outcome(vars, { kind: 'shared', ok: false, error: \"That card isn't an Obsidian note.\" });\nreturn outcome(vars, { kind: 'shared', ok: true, cardId: target, shared: false, message: 'Taken back from the players.' }, { target: target });"
      }
    },
    {
      "Type": "If",
      "Data": {
        "Label": "Stop if that failed",
        "Condition": "'%failed%' = 'yes'",
        "Then": [
          {
            "Type": "If",
            "Data": {
              "Label": "Tell the GM",
              "Condition": "'%hasReply%' = 'yes'",
              "Then": [
                {
                  "Type": "RunClientCommand",
                  "Data": {
                    "Label": "Answer the window that asked",
                    "Panel": "%replyTo%",
                    "Command": "Reply",
                    "Player": "%playerId%",
                    "Data": "%reply%"
                  }
                }
              ],
              "Else": [
                {
                  "Type": "SendChat",
                  "Data": {
                    "Label": "Or whisper it",
                    "Template": "Text",
                    "Title": "Obsidian",
                    "Message": "%notice%",
                    "Player": "%playerId%"
                  }
                }
              ]
            }
          },
          {
            "Type": "Exit",
            "Data": {
              "Label": "Stop"
            }
          }
        ]
      }
    },
    {
      "Type": "SetPermission",
      "Data": {
        "Label": "Take it back",
        "EntityId": "%target%",
        "Permission": "Read",
        "Revoke": true
      }
    },
    {
      "Type": "If",
      "Data": {
        "Label": "Tell the GM",
        "Condition": "'%hasReply%' = 'yes'",
        "Then": [
          {
            "Type": "RunClientCommand",
            "Data": {
              "Label": "Answer the window that asked",
              "Panel": "%replyTo%",
              "Command": "Reply",
              "Player": "%playerId%",
              "Data": "%reply%"
            }
          }
        ],
        "Else": [
          {
            "Type": "SendChat",
            "Data": {
              "Label": "Or whisper it",
              "Template": "Text",
              "Title": "Obsidian",
              "Message": "%notice%",
              "Player": "%playerId%"
            }
          }
        ]
      }
    }
  ]
}
