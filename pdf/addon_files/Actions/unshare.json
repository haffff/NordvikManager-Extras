{
  "$schema": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/action.json",
  "name": "unshare",
  "description": "Takes a share back from the players and deletes its file; notes on its pages stay. GM only. Args: documentId, shareId.",
  "hook": 0,
  "prefix": "pdf",
  "genericPermission": 0,
  "gmPermission": 31,
  "content": [
    { "Type": "RequirePermission", "Data": { "Label": "GMs only", "EntityId": "%gameId%", "Permission": "Edit", "StopIfDenied": "true" } },
    { "Type": "RunScript", "Data": { "Label": "Check and do it", "Include": "pdf_pdf.js", "Script": "return removeShare(game, vars);" } },
    { "Type": "If", "Data": { "Label": "Anything to say?", "Condition": "'%hasNotice%' = 'yes'", "Then": [ { "Type": "SendChat", "Data": { "Label": "Whisper it", "Template": "Text", "Title": "PDF", "Message": "%notice%", "Player": "%playerId%" } } ] } }
  ]
}
