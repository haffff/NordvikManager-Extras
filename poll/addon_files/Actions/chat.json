{
  "$schema": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/action.json",
  "name": "chat",
  "description": "Chat commands: /vote <pick> votes in the current poll; /poll Question? | A | B starts one (switches --secret --hidden --multi --change); /poll close closes the current one; /poll shows it.",
  "hook": 19,
  "hookFilter": "poll, vote",
  "prefix": "poll",
  "genericPermission": 0,
  "gmPermission": 31,
  "content": [
    {
      "Type": "RunScript",
      "Data": {
        "Label": "Handle /vote and /poll",
        "Include": "poll_poll.js",
        "Script": "return chatCommand(game, vars);"
      }
    },
    {
      "Type": "If",
      "Data": {
        "Label": "Another command?",
        "Condition": "'%ignore%' = 'yes'",
        "Then": [
          {
            "Type": "Exit",
            "Data": {
              "Label": "Not ours"
            }
          }
        ]
      }
    },
    {
      "Type": "If",
      "Data": {
        "Label": "Tell whoever asked",
        "Condition": "'%hasReply%' = 'yes'",
        "Then": [
          {
            "Type": "RunClientCommand",
            "Data": {
              "Label": "Answer the window that asked",
              "Panel": "%replyTo%",
              "Command": "Reply",
              "Player": "%playerId%",
              "Data": "%reply%"
            }
          }
        ],
        "Else": [
          {
            "Type": "If",
            "Data": {
              "Label": "Anything to say?",
              "Condition": "'%hasNotice%' = 'yes'",
              "Then": [
                {
                  "Type": "SendChat",
                  "Data": {
                    "Label": "Whisper it",
                    "Template": "Text",
                    "Title": "Poll",
                    "Message": "%notice%",
                    "Player": "%playerId%"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
