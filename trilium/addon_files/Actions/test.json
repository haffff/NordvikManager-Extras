{
  "$schema": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/action.json",
  "name": "test",
  "description": "Asks Trilium for its version with the saved address and token. Args: replyTo.",
  "hook": 0,
  "prefix": "trilium",
  "genericPermission": 0,
  "gmPermission": 31,
  "content": [
    {
      "Type": "RequirePermission",
      "Data": {
        "Label": "Only GMs",
        "EntityId": "%gameId%",
        "Permission": "Edit",
        "StopIfDenied": true
      }
    },
    {
      "Type": "GetPropertyValue",
      "Data": {
        "Label": "The Trilium address",
        "Of": "game",
        "PropertyName": "trilium_url",
        "Output": "url",
        "DefaultValue": ""
      }
    },
    {
      "Type": "RunScript",
      "Data": {
        "Label": "The address to ask",
        "Include": "trilium_trilium.js",
        "Script": "const base = baseUrl(vars.url);\nif (!base) return outcome(vars, { kind: 'test', ok: false, error: 'Save the Trilium address first.' });\nreturn outcome(vars, { kind: 'test', ok: true }, { infoUrl: base + '/etapi/app-info' });"
      }
    },
    {
      "Type": "If",
      "Data": {
        "Label": "Stop if that failed",
        "Condition": "'%failed%' = 'yes'",
        "Then": [
          {
            "Type": "If",
            "Data": {
              "Label": "Tell the GM",
              "Condition": "'%hasReply%' = 'yes'",
              "Then": [
                {
                  "Type": "RunClientCommand",
                  "Data": {
                    "Label": "Answer the window that asked",
                    "Panel": "%replyTo%",
                    "Command": "Reply",
                    "Player": "%playerId%",
                    "Data": "%reply%"
                  }
                }
              ],
              "Else": [
                {
                  "Type": "SendChat",
                  "Data": {
                    "Label": "Or whisper it",
                    "Template": "Text",
                    "Title": "Trilium",
                    "Message": "%notice%",
                    "Player": "%playerId%"
                  }
                }
              ]
            }
          },
          {
            "Type": "Exit",
            "Data": {
              "Label": "Stop"
            }
          }
        ]
      }
    },
    {
      "Type": "SendRequest",
      "Data": {
        "Label": "Ask Trilium",
        "TargetUrl": "%infoUrl%",
        "HttpMethod": "GET",
        "BearerTokenPropertyName": "trilium_token",
        "Output": "info"
      }
    },
    {
      "Type": "RunScript",
      "Data": {
        "Label": "What it said",
        "Include": "trilium_trilium.js",
        "Script": "const r = readResponse(vars.info, 'its version');\nif (!r.ok) return outcome(vars, { kind: 'test', ok: false, error: r.error });\nconst version = String((r.body && r.body.appVersion) || '?');\nreturn outcome(vars, { kind: 'test', ok: true, version: version, message: 'Connected to Trilium ' + version + '.' });"
      }
    },
    {
      "Type": "If",
      "Data": {
        "Label": "Tell the GM",
        "Condition": "'%hasReply%' = 'yes'",
        "Then": [
          {
            "Type": "RunClientCommand",
            "Data": {
              "Label": "Answer the window that asked",
              "Panel": "%replyTo%",
              "Command": "Reply",
              "Player": "%playerId%",
              "Data": "%reply%"
            }
          }
        ],
        "Else": [
          {
            "Type": "SendChat",
            "Data": {
              "Label": "Or whisper it",
              "Template": "Text",
              "Title": "Trilium",
              "Message": "%notice%",
              "Player": "%playerId%"
            }
          }
        ]
      }
    }
  ]
}
